# ── AI Cloud Providers ────────────────────────────────────────────────────────
# The proxy auto-detects the provider from the model name in each request.
# Only set the key(s) for providers you use — others can stay blank.

MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_BASE_URL=https://api.mistral.ai

OPENAI_API_KEY=


# ── ElevenLabs (speech-to-text via scribe_v1) ────────────────────────────────
# Used by the playground mic button: records → screens PII locally → bleeps → ElevenLabs STT
ELEVENLABS_API_KEY=

# ── Local Ollama (Ministral 3b / vision) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Model must support vision for image screening
OLLAMA_MODEL=mistral:latest

# ── Whisper (audio transcription) ─────────────────────────────────────────────
# tiny | base | small | medium | large
WHISPER_MODEL=tiny

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
